# ── IntentShield environment ────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env or real secret values.
# Everything in this file is SERVER-SIDE ONLY — none of it may ever reach
# the browser.

# Database (Prisma / SQLite). The path is resolved relative to the prisma/
# folder, so this value points at <repo>/db/custom.db. The file is created
# by `bun run setup` (prisma generate + prisma db push).
DATABASE_URL="file:../db/custom.db"

# PayPal — required for guarded sandbox execution. Without these, the PayPal
# layer reports an honest "not configured" error and execution stays
# unavailable (IntentShield never fakes PayPal responses).
# Get sandbox credentials: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# AI provider — used for intent extraction and product proposals ONLY
# (never authorization). Two supported values:
#
#   "openai" — any OpenAI-compatible HTTP endpoint (local or remote).
#              Requires AI_BASE_URL, AI_API_KEY and AI_MODEL below.
#              Examples: OpenAI, OpenRouter, Ollama, LM Studio, vLLM.
#   "zai"    — the Z Cloud platform default (z-ai-web-dev-sdk).
#              No additional variables required on that platform.
AI_PROVIDER=openai

# OpenAI-compatible endpoint configuration (only used when AI_PROVIDER=openai).
# AI_BASE_URL must include the version segment, exactly as the provider
# documents it, with no trailing slash, e.g.:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://localhost:11434/v1
#   LM Studio:   http://localhost:1234/v1
# Local servers (Ollama, LM Studio) do not check the key — set any non-empty
# placeholder such as "local".
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
